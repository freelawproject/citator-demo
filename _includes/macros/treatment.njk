{# Treatment indicators.
   - severityBadge(severity, label, small=false, definition=""): the pill
     every treatment renders as; `small` is the filter menus' size. With
     a `definition` (treatment_definitions[label], global data that a
     macro cannot read itself) the pill shows it on hover and focus.
   - validationDot(state, expert_treatment): the expert-validation mark
     beside a pill; only rendered when the `validation` build flag is on. #}
{% from "macros/icons.njk" import icon %}

{% macro severityBadge(severity, label, small=false, definition="") %}
  {%- if severity == "Stop" -%}
    {%- set variant = "severity-badge--stop" -%}{%- set glyph = "severity-stop" -%}
  {%- elif severity == "Warning" -%}
    {%- set variant = "severity-badge--warning" -%}{%- set glyph = "severity-warning" -%}
  {%- elif severity == "Caution" -%}
    {%- set variant = "severity-badge--caution" -%}{%- set glyph = "severity-caution" -%}
  {%- else -%}
    {%- set variant = "severity-badge--neutral" -%}{%- set glyph = "severity-neutral" -%}
  {%- endif -%}
  <span class="severity-badge {{ variant }}{% if small %} severity-badge--small{% endif %}{% if definition %} tooltip-target severity-badge--defined" data-tooltip="{{ definition }}" tabindex="0{% endif %}">{{ icon(glyph, "severity-badge__icon") }}<span class="severity-badge__label">{{ label }}</span></span>
{% endmacro %}

{% macro validationDot(state, expert_treatment="") %}
  {%- if state == "agree" -%}
    {%- set tooltip = "Validated" -%}
    {%- set label = "Validated treatment classification" -%}
    {%- set glyph = icon("check-circle", "validation-dot__icon text-blue-700") -%}
  {%- elif state == "disagree" -%}
    {%- if expert_treatment -%}
      {%- set tooltip = "Invalidated\nExpert: " ~ expert_treatment -%}
      {%- set label = "Invalidated by expert. Expert classification: " ~ expert_treatment -%}
    {%- else -%}
      {%- set tooltip = "Invalidated" -%}
      {%- set label = "Invalidated treatment classification" -%}
    {%- endif -%}
    {%- set glyph = icon("x-circle", "validation-dot__icon text-purple-600") -%}
  {%- else -%}
    {%- set tooltip = "Unvalidated" -%}
    {%- set label = "Unvalidated treatment classification" -%}
    {%- set glyph = icon("question-circle", "validation-dot__icon text-greyscale-500") -%}
  {%- endif -%}
  <span class="validation-dot tooltip-target" data-tooltip="{{ tooltip }}" role="img" aria-label="{{ label }}" tabindex="0">{{ glyph }}</span>
{% endmacro %}
