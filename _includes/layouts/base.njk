{% from "macros/icons.njk" import icon %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="description" content="An AI-powered citator preview from Free Law Project. Surfaces how each opinion treats its cited cases and how subsequent opinions have treated it.">
    <title>{{ title or "Citator Demo" }} — Free Law Project</title>
    <link rel="stylesheet" href="/assets/css/styles.css?v={{ build.stamp }}">
    {# Component scripts must precede alpine.min.js: the bundle calls
       Alpine.start() synchronously, so an alpine:init listener registered
       after it never fires. #}
    <script defer src="/assets/js/alpine/composables/highlight.js?v={{ build.stamp }}"></script>
    <script defer src="/assets/js/alpine/composables/list_toggle.js?v={{ build.stamp }}"></script>
    <script defer src="/assets/js/alpine/components/back_nav.js?v={{ build.stamp }}"></script>
    <script defer src="/assets/js/alpine/components/about_hint.js?v={{ build.stamp }}"></script>
    <script defer src="/assets/js/same_page_links.js?v={{ build.stamp }}"></script>
    <script defer src="/assets/js/cite_fit.js?v={{ build.stamp }}"></script>
    {% for s in scripts %}
    <script defer src="{{ s }}?v={{ build.stamp }}"></script>
    {% endfor %}
    <script defer src="/assets/js/alpine.min.js?v={{ build.stamp }}"></script>
  </head>
  <body class="min-h-screen flex flex-col">

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <a href="#footer" class="skip-link">Skip to footer</a>

    <header class="site-header">
      <div class="capped-width px-4 md:px-10 py-4 flex items-center justify-between gap-4">
        <a href="/" class="site-header__wordmark">Citator preview</a>
        <nav class="flex items-center gap-2" aria-label="Site">
          <div x-data="aboutHint" class="about-hint">
            {% if page.url != "/about/" %}
            <a href="/about/" class="site-header__link" x-bind:class="hintLinkClass" x-on:click="dismiss">
              {{ icon("info", "w-4 h-4") }}
              About this citator
            </a>
            <div x-show="open" x-cloak class="about-hint__bubble" role="note">
              <span>New here? Start with what the preview is and how to read it.</span>
              <button type="button" class="about-hint__close" x-on:click="dismiss" aria-label="Dismiss">
                {{ icon("close", "w-3.5 h-3.5") }}
              </button>
            </div>
            {% endif %}
          </div>
          <a href="/about/#feedback" class="site-header__cta">
            {{ icon("chat", "w-4 h-4") }}
            Share feedback
          </a>
        </nav>
      </div>
    </header>

    <p class="desktop-notice md:hidden" role="note">
      For the best experience, use a desktop.
    </p>

    <main id="main-content" class="capped-width px-4 md:px-10 py-6 flex-1">
      {% if page.url != "/" and backNav != "inline" %}
      {% include "partials/back-nav.njk" %}
      {% endif %}
      {{ content | safe }}
    </main>

    <footer id="footer" class="site-footer">
      <div class="capped-width px-4 md:px-10 py-6 flex flex-wrap items-center gap-2">
        <span>Generated {{ build.date }}</span>
        <span aria-hidden="true">·</span>
        <span>AI-powered citator preview</span>
        <span aria-hidden="true">·</span>
        <a href="/about/" class="links">About this citator</a>
        <span aria-hidden="true">·</span>
        <a href="https://free.law/" class="links" target="_blank" rel="noopener">Free Law Project</a>
      </div>
    </footer>

  </body>
</html>
