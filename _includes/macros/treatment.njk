{# Shared macros for rendering treatments and their indicators.

   - severityBadge / validationDot: primitives used by both treatment forms.
   - treatmentBlock: verbose card-style block (opinion page summary).
   - treatmentLine: compact form with hidden hover tooltip (search results). #}

{% macro severityBadge(severity, label) %}
  {% set base = "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide" %}
  {% set iconSize = "w-3.5 h-3.5 flex-shrink-0" %}
  {% if severity == "Stop" %}
    {% set classes = base ~ " bg-red-500/10 text-red-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" /></svg>{% endset %}
  {% elif severity == "Warning" %}
    {% set classes = base ~ " bg-orange-500/10 text-orange-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>{% endset %}
  {% elif severity == "Caution" %}
    {% set classes = base ~ " bg-amber-500/15 text-amber-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a.75.75 0 00-.75.75v3.5a.75.75 0 001.5 0v-3.5A.75.75 0 0010 5z" clip-rule="evenodd" /></svg>{% endset %}
  {% else %}
    {% set classes = base ~ " bg-greyscale-200 text-greyscale-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9.5a.75.75 0 000 1.5h6a.75.75 0 000-1.5H7z" clip-rule="evenodd" /></svg>{% endset %}
  {% endif %}
  <span class="{{ classes }}">{{ icon | safe }}{{ label }}</span>
{% endmacro %}

{% macro validationDot(state) %}
  {% set svgBase = "w-4 h-4 flex-shrink-0" %}
  {% if state == "agree" %}
    {% set label = "Model agrees with expert" %}
    {% set svg %}<svg class="{{ svgBase }} text-blue-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
  {% elif state == "disagree" %}
    {% set label = "Model disagrees with expert" %}
    {% set svg %}<svg class="{{ svgBase }} text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
  {% else %}
    {% set label = "Treatment not expert-validated" %}
    {% set svg %}<svg class="{{ svgBase }} text-greyscale-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>{% endset %}
  {% endif %}
  <span class="tooltip-target tooltip-target--right p-1 -m-1 align-middle" data-tooltip="{{ label }}" role="img" aria-label="{{ label }}">
    {{ svg | safe }}
  </span>
{% endmacro %}

{# Verbose form: severity badge + validation icon + visible citing-case
   metadata. Used on opinion pages where there is room to show context. #}
{% macro treatmentBlock(pointer, label="") %}
  {% if pointer.severity == "Stop" %}
    {% set headerBg = "bg-red-500/5 border-red-500/20" %}
  {% elif pointer.severity == "Warning" %}
    {% set headerBg = "bg-orange-500/5 border-orange-500/20" %}
  {% elif pointer.severity == "Caution" %}
    {% set headerBg = "bg-amber-500/10 border-amber-500/20" %}
  {% else %}
    {% set headerBg = "bg-greyscale-100 border-greyscale-200" %}
  {% endif %}
  <article class="rounded-2xl border border-greyscale-200 bg-white">
    {% if label %}
    <header class="rounded-t-2xl px-5 py-3 border-b {{ headerBg }}">
      <span class="text-xs uppercase tracking-wide font-semibold text-greyscale-600">{{ label }}</span>
    </header>
    {% endif %}
    <div class="px-5 py-4">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-2">
        {% if pointer.is_scoped %}
          <a class="hover:brightness-95 transition" href="/opinion/{{ pointer.citing_cluster_id }}/">
            {{ severityBadge(pointer.severity, pointer.treatment) }}
          </a>
        {% else %}
          {{ severityBadge(pointer.severity, pointer.treatment) }}
        {% endif %}
        <span class="font-semibold text-greyscale-900">
          {% if pointer.is_scoped %}
            <a href="/opinion/{{ pointer.citing_cluster_id }}/" class="hover:text-primary-700 hover:underline">{{ pointer.citing_case_name }}</a>
          {% else %}
            {{ pointer.citing_case_name }}
          {% endif %}
        </span>
        {{ validationDot(pointer.validation.state) }}
      </div>
      <dl class="mt-3 grid gap-y-1 text-xs">
        <div class="flex flex-wrap gap-x-10 gap-y-0.5">
          <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
            <dt class="uppercase tracking-wide font-semibold text-greyscale-500">Court</dt>
            <dd class="text-greyscale-700">{{ pointer.citing_court_display }}</dd>
          </div>
          <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
            <dt class="uppercase tracking-wide font-semibold text-greyscale-500">File Date</dt>
            <dd class="text-greyscale-700">{{ pointer.citing_date_filed }}</dd>
          </div>
        </div>
        {% if pointer.citing_citation %}
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
          <dt class="uppercase tracking-wide font-semibold text-greyscale-500">Citations</dt>
          <dd class="text-greyscale-700">{{ pointer.citing_citation }}</dd>
        </div>
        {% endif %}
      </dl>

      {% if pointer.expand and pointer.expand.context %}
      {% set ctx = pointer.expand.context %}
      <details class="treatment-expand mt-4">
        <summary class="cursor-pointer inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 select-none">
          <svg class="w-3.5 h-3.5 expand-chevron transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
          <span>Show supporting quote</span>
        </summary>
        <p class="mt-3 pl-3 border-l-2 border-greyscale-200 text-sm text-greyscale-700 leading-relaxed">
          {%- if ctx.before %}{{ ctx.before }} {% endif -%}
          <span class="inline bg-yellow-100 text-greyscale-900 font-semibold rounded px-1">{{ ctx.quote }}</span>
          {%- if ctx.after %} {{ ctx.after }}{% endif -%}
        </p>
      </details>
      {% endif %}
    </div>
  </article>
{% endmacro %}

{# Compact form: severity badge + validation icon, with citing-case context
   in a hover tooltip. Used on the search results cards. #}
{% macro treatmentLine(pointer) %}
  {% set tipBody %}
    <span class="rich-tooltip absolute top-full mt-2 right-0 z-20 w-max max-w-[280px] bg-greyscale-900 text-white rounded-lg shadow-lg px-4 py-3 text-left pointer-events-none opacity-0 invisible transition-opacity">
      <span class="block font-semibold text-sm leading-snug">{{ pointer.citing_case_name }}</span>
      <span class="mt-2.5 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-xs leading-normal">
        <span class="font-semibold uppercase tracking-wide text-[10px] text-greyscale-200">Court</span>
        <span>{{ pointer.citing_court_display }}</span>
        <span class="font-semibold uppercase tracking-wide text-[10px] text-greyscale-200">File Date</span>
        <span>{{ pointer.citing_date_filed }}</span>
      </span>
    </span>
  {% endset %}
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm">
    {% if pointer.is_scoped %}
      <a class="relative tooltip-host hover:brightness-95 transition" href="/opinion/{{ pointer.citing_cluster_id }}/">
        {{ severityBadge(pointer.severity, pointer.treatment) }}
        {{ tipBody | safe }}
      </a>
    {% else %}
      <span class="relative tooltip-host">
        {{ severityBadge(pointer.severity, pointer.treatment) }}
        {{ tipBody | safe }}
      </span>
    {% endif %}
    {{ validationDot(pointer.validation.state) }}
  </div>
{% endmacro %}
