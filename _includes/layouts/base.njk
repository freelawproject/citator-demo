<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="description" content="An AI-powered citator preview from Free Law Project. Surfaces how each opinion treats its cited cases and how subsequent opinions have treated it.">
    <title>{{ title or "Citator Demo" }} — Free Law Project</title>
    <link rel="stylesheet" href="/assets/css/styles.css">
    {# Component scripts must precede alpine.min.js: the CDN build calls
       Alpine.start() synchronously, so any alpine:init listener registered
       after it never fires. #}
    {% if scripts %}{% for s in scripts %}
    <script defer src="{{ s }}"></script>
    {% endfor %}{% endif %}
    <script defer src="/assets/js/alpine.min.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <a href="#footer" class="skip-link">Skip to footer</a>

    {% if build.placeholder_until %}
      <div class="alert-warning capped-width mx-4 md:mx-auto mt-4 mb-2">
        <strong class="font-semibold">Preview build with placeholder data.</strong>
        Real inference data lands the week of {{ build.placeholder_until }}. Treatments and validation indicators on this site are illustrative until then.
      </div>
    {% endif %}

    <header class="w-full border-b border-greyscale-200 bg-greyscale-50">
      <div class="capped-width px-4 md:px-10 py-4 flex items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-1.5 font-cooper text-lg font-semibold text-primary-700 hover:text-primary-900 transition">
          {% if page.url != "/" %}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
          {% endif %}
          <span>Citator preview</span>
        </a>
        <nav class="flex items-center gap-2">
          {% if page.url != "/about/" %}
          <a href="/about/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium text-greyscale-700 hover:text-primary-700 hover:bg-primary-50 transition">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
            </svg>
            About this citator
          </a>
          {% endif %}
          <a href="/about/#feedback" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-semibold bg-primary-600 text-white hover:bg-primary-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-primary-300 transition">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            Share feedback
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="capped-width px-4 md:px-10 py-6 flex-1">
      {{ content | safe }}
    </main>

    <div class="w-full border-t border-greyscale-200 bg-greyscale-50">
      <footer id="footer" class="capped-width px-4 md:px-10 py-6 text-xs text-greyscale-500">
        <div class="flex flex-wrap items-center gap-2">
          <span>Generated {{ build.date }}</span>
          <span aria-hidden="true">·</span>
          <span>AI-powered citator preview</span>
          <span aria-hidden="true">·</span>
          <a href="/about/" class="links">About this citator</a>
          <span aria-hidden="true">·</span>
          <a
            href="https://free.law/"
            class="links"
            target="_blank"
            rel="noopener"
          >Free Law Project</a>
        </div>
        {# "Found something wrong?" link wired in #11 (Google Form URL). #}
      </footer>
    </div>

  </body>
</html>
