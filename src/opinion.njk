---
layout: layouts/base.njk
pagination:
  data: allOpinions
  size: 1
  alias: opinion
permalink: "/opinion/{{ opinion.cluster_id }}/"
scripts:
  - /assets/js/alpine/components/opinion_tabs.js
  - /assets/js/alpine/components/treatment_list.js
backNav: inline
eleventyComputed:
  title: "{{ opinion.case_name }}"
---
{# Opinion page: case card, four tabs (components/opinion_tabs.js), a
   "Jump to" sidebar and the occurrence navigator for citations. #}
{% from "macros/status.njk" import statusRows %}
{% from "macros/icons.njk" import icon %}
{% from "macros/lists.njk" import citeList %}

{% set historySteps = opinion.appellate_history.steps | length %}
{% set tabs = [
  {"id": "opinion", "label": "Opinion", "count": 0},
  {"id": "authorities", "label": "Authorities", "count": opinion.cited_authorities | length},
  {"id": "cited-by", "label": "Cited By", "count": opinion.cited_by | length},
  {"id": "history", "label": "History", "count": historySteps if historySteps > 1 else 0}
] %}

<article x-data="opinionTabs" class="opinion-page">
  {# "Jump to" list beside the whole page; writing links switch to the
     Opinion tab first so the target section is visible #}
  <aside class="opinion-sidebar" aria-label="Jump to">
    <nav class="jump-links">
      <h2 class="jump-links__title">Jump to</h2>
      <ul>
        <li><a href="#top" class="jump-links__link">Top</a></li>
        <li><a href="#treatment-summary" class="jump-links__link">Status</a></li>
        {% if opinion.document.sections | length > 1 %}
          {% for s in opinion.document.sections %}
          <li><a href="#{{ s.anchor }}" class="jump-links__link">{{ s.title }}</a></li>
          {% endfor %}
        {% else %}
          <li><a href="#panel-opinion" class="jump-links__link">Opinion</a></li>
        {% endif %}
      </ul>
    </nav>
  </aside>

  <div class="opinion-main">
  {# compact case bar: appears once the metadata card has scrolled past #}
  <div class="case-bar-anchor">
    <div class="case-bar" x-bind:class="caseBarClass" x-bind:aria-hidden="caseBarHidden">
      <a href="#top" class="case-bar__name" title="{{ opinion.case_name }}">{{ opinion.case_name }}</a>
      <span class="case-bar__meta">{{ opinion.court_display }} <span class="case-bar__dot" aria-hidden="true">·</span> {{ opinion.date_filed }}</span>
    </div>
  </div>

  {% include "partials/back-nav.njk" %}
  <div class="opinion-card" x-ref="caseCard">
    <header class="max-w-3xl">
      <h1 class="font-cooper text-display-sm md:text-display-md font-semibold text-greyscale-900 leading-tight">
        {{ opinion.case_name }}
      </h1>
      <dl class="meta-list mt-3">
        <div><dt>Court</dt><dd>{{ opinion.court_display }}</dd></div>
        <div><dt>File Date</dt><dd>{{ opinion.date_filed }}</dd></div>
        {% if opinion.docket_numbers | length %}<div><dt>Docket Number</dt><dd>{{ citeList(opinion.docket_numbers, noun="docket number") }}</dd></div>{% endif %}
        {% if opinion.citations | length %}
        <div class="basis-full"><dt>Citations</dt><dd>{% for c in opinion.citations %}{{ c }}{% if not loop.last %} <span class="cite-list__dot" aria-hidden="true">·</span> {% endif %}{% endfor %}</dd></div>
        {% endif %}
      </dl>
    </header>
    <section id="treatment-summary" aria-label="Status of this opinion">
      {{ statusRows(opinion.status, opinion.disposition, "opinion-status") }}
    </section>
  </div>

  <div class="tab-bar" role="tablist" aria-label="Opinion sections">
    {% for tab in tabs %}
    <button type="button" role="tab" id="tab-{{ tab.id }}" aria-controls="panel-{{ tab.id }}"
            data-tab="{{ tab.id }}"
            x-bind:aria-selected="tabSelected" x-bind:tabindex="tabIndex" x-bind:class="tabClass"
            x-on:click="selectTab" x-on:keydown="onKeydown"
            class="tab-bar__tab">
      {{ tab.label }}{% if tab.count %} <span class="tab-count" data-tab="{{ tab.id }}" x-bind:class="tabCountClass">{{ tab.count }}</span>{% endif %}
    </button>
    {% endfor %}
  </div>

  <div class="mt-6">
    {% for tab in tabs %}
    <section role="tabpanel" id="panel-{{ tab.id }}" aria-labelledby="tab-{{ tab.id }}"
             data-tab="{{ tab.id }}" x-show="panelVisible" x-cloak tabindex="0">
      {% if tab.id == "opinion" %}
        <div class="opinion-body">
          {{ opinion.document.body_html | safe }}
        </div>
      {% elif tab.id == "authorities" %}
        {% include "partials/authorities-tab.njk" %}
      {% elif tab.id == "cited-by" %}
        {% include "partials/cited-by-tab.njk" %}
      {% elif tab.id == "history" %}
        {% include "partials/history-tab.njk" %}
      {% endif %}
    </section>
    {% endfor %}
  </div>
  </div>

  {# occurrence navigator: opens on a citation click, steps through every
     mention of that authority; the name opens the authority's page when
     the site has one #}
  <div class="occ-nav" x-show="occNavOpen" x-cloak role="dialog" aria-label="Citation occurrences">
    <div class="occ-nav__text">
      <a class="occ-nav__name" x-show="occNavHasUrl" x-bind:href="occNavUrl" x-text="occNavName" href="/"></a>
      <span class="occ-nav__name" x-show="occNavNoUrl" x-text="occNavName"></span>
      <span class="occ-nav__count" x-text="occNavCount"></span>
    </div>
    <div class="occ-nav__buttons">
      <button type="button" x-on:click="occPrev" class="occ-nav__btn" aria-label="Previous occurrence">
        {{ icon("chevron-up", "w-4 h-4") }}
        Previous
      </button>
      <button type="button" x-on:click="occNext" class="occ-nav__btn" aria-label="Next occurrence">
        Next
        {{ icon("chevron-down", "w-4 h-4") }}
      </button>
      <button type="button" x-on:click="occToRow" class="occ-nav__btn occ-nav__btn--row">
        Authority entry
        {{ icon("arrow-right", "w-3.5 h-3.5") }}
      </button>
      <button type="button" x-on:click="occClose" class="occ-nav__close" aria-label="Close">
        {{ icon("close", "w-4 h-4") }}
      </button>
    </div>
  </div>

  <a href="#top" class="back-to-top" aria-label="Back to top">
    {{ icon("chevron-up", "w-4 h-4") }}
    <span>Top</span>
  </a>
</article>
