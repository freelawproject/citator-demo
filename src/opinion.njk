---
layout: layouts/base.njk
pagination:
  data: allOpinions
  size: 1
  alias: opinion
permalink: "/opinion/{{ opinion.cluster_id }}/"
scripts:
  - /assets/js/alpine/components/opinion_tabs.js
  - /assets/js/alpine/components/authorities_filter.js
  - /assets/js/alpine/components/cited_by_filter.js
  - /assets/js/alpine/components/summary_picker.js
eleventyComputed:
  title: "{{ opinion.case_name }}"
---
{% from "macros/treatment.njk" import treatmentBlock, severityBadge, validationDot %}

{% set tabs = [
  {"id": "opinion", "label": "Opinion"},
  {"id": "authorities", "label": "Authorities"},
  {"id": "cited-by", "label": "Cited By"}
] %}

<article x-data="opinionTabs">
  <header class="max-w-3xl">
    <h1 class="font-cooper text-display-sm md:text-display-md font-semibold text-greyscale-900 leading-tight">
      {{ opinion.case_name }}
    </h1>
    <dl class="mt-3 grid gap-y-1.5 text-sm">
      <div class="flex flex-wrap gap-x-10 gap-y-1">
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
          <dt class="text-xs uppercase tracking-wide font-semibold text-greyscale-500">Court</dt>
          <dd class="text-greyscale-700">{{ opinion.court_display }}</dd>
        </div>
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
          <dt class="text-xs uppercase tracking-wide font-semibold text-greyscale-500">File Date</dt>
          <dd class="text-greyscale-700">{{ opinion.date_filed }}</dd>
        </div>
        {% if opinion.docket_number %}
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
          <dt class="text-xs uppercase tracking-wide font-semibold text-greyscale-500">Docket Number</dt>
          <dd class="text-greyscale-700">{{ opinion.docket_number }}</dd>
        </div>
        {% endif %}
      </div>
      {% if opinion.citations %}
      <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
        <dt class="text-xs uppercase tracking-wide font-semibold text-greyscale-500 flex-shrink-0">Citations</dt>
        <dd class="text-greyscale-700">
          {% for c in opinion.citations %}{{ c }}{% if not loop.last %} <span class="text-greyscale-400" aria-hidden="true">·</span> {% endif %}{% endfor %}
        </dd>
      </div>
      {% endif %}
    </dl>
  </header>

  <section aria-label="Treatment summary" class="mt-6">
    {% set dh = opinion.summary.direct_history %}
    {% set cr = opinion.summary.most_severe_treatment %}
    {# Always render two views: Direct history and Citing reference.
       Citing reference surfaces the most severe non-direct negative
       treatment; users can sort the Cited By tab for the full list. #}
    <div x-data="summaryPicker('direct_history')">
      <div role="tablist" aria-label="Treatment summary view" class="mb-3 inline-flex rounded-lg border border-greyscale-300 overflow-hidden text-xs font-semibold uppercase tracking-wide">
        <button
          type="button"
          role="tab"
          data-view="direct_history"
          x-on:click="setView('direct_history')"
          x-on:keydown="onKeydown($event)"
          x-bind:aria-selected="view === 'direct_history' ? 'true' : 'false'"
          x-bind:tabindex="view === 'direct_history' ? 0 : -1"
          x-bind:class="view === 'direct_history' ? 'bg-greyscale-900 text-white' : 'bg-white text-greyscale-600 hover:bg-greyscale-50'"
          class="px-3 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-300"
        >
          Direct history
        </button>
        <button
          type="button"
          role="tab"
          data-view="citing_reference"
          x-on:click="setView('citing_reference')"
          x-on:keydown="onKeydown($event)"
          x-bind:aria-selected="view === 'citing_reference' ? 'true' : 'false'"
          x-bind:tabindex="view === 'citing_reference' ? 0 : -1"
          x-bind:class="view === 'citing_reference' ? 'bg-greyscale-900 text-white' : 'bg-white text-greyscale-600 hover:bg-greyscale-50'"
          class="px-3 py-1.5 border-l border-greyscale-300 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-300"
        >
          Citing reference
        </button>
      </div>

      <div x-show="view === 'direct_history'" x-cloak>
        {% if dh %}
          {{ treatmentBlock(dh, "") }}
        {% else %}
          <article class="rounded-2xl border border-greyscale-200 bg-white px-5 py-4">
            {% if opinion.is_court_of_last_resort %}
            <p class="text-sm text-greyscale-600 leading-relaxed">
              <span class="font-semibold text-greyscale-900">{{ opinion.court_display }}</span> is a court of last resort. Decisions from this court are not subject to direct appellate review.
            </p>
            {% else %}
            <p class="text-sm text-greyscale-600 leading-relaxed">
              No higher-court appellate history has been identified for this opinion.
            </p>
            {% endif %}
          </article>
        {% endif %}
      </div>

      <div x-show="view === 'citing_reference'" x-cloak>
        {% if cr %}
          {{ treatmentBlock(cr, "") }}
        {% else %}
          <article class="rounded-2xl border border-greyscale-200 bg-white px-5 py-4">
            <p class="text-sm text-greyscale-600 leading-relaxed">
              No negative citing references identified for this opinion.
            </p>
          </article>
        {% endif %}
      </div>
    </div>
  </section>

  <div
    class="mt-8 border-b border-greyscale-200 flex gap-2"
    role="tablist"
    aria-label="Opinion sections"
  >
    {% for tab in tabs %}
    <button
      type="button"
      role="tab"
      id="tab-{{ tab.id }}"
      aria-controls="panel-{{ tab.id }}"
      x-bind:aria-selected="activeTab === '{{ tab.id }}' ? 'true' : 'false'"
      x-bind:tabindex="activeTab === '{{ tab.id }}' ? 0 : -1"
      x-bind:class="activeTab === '{{ tab.id }}' ? 'border-primary-600 text-primary-700' : 'border-transparent text-greyscale-600 hover:text-greyscale-900 hover:border-greyscale-300'"
      class="px-4 py-2.5 -mb-px border-b-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:rounded-t"
      x-on:click="setTab('{{ tab.id }}')"
      x-on:keydown="onKeydown($event)"
    >
      {{ tab.label }}
    </button>
    {% endfor %}
  </div>

  <div class="mt-6">
    {% for tab in tabs %}
    <section
      role="tabpanel"
      id="panel-{{ tab.id }}"
      aria-labelledby="tab-{{ tab.id }}"
      x-show="activeTab === '{{ tab.id }}'"
      x-cloak
      tabindex="0"
    >
      {% if tab.id == "opinion" %}
        <div class="opinion-body">
          {{ opinion.document.body_html | safe }}
        </div>
      {% elif tab.id == "authorities" %}
        {% include "partials/authorities-tab.njk" %}
      {% elif tab.id == "cited-by" %}
        {% include "partials/cited-by-tab.njk" %}
      {% endif %}
    </section>
    {% endfor %}
  </div>
</article>
