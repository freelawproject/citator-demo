{# A clamped list of citations: up to `limit` entries show, as many of
   them as fit on one line of the enclosing <dd> (assets/js/cite_fit.js
   measures and hides the rest); every other entry sits behind a "+N"
   button (composables/list_toggle.js) that expands the <dd> in place.
   Without script the first `limit` entries show. `dot` separates entries
   with a middle dot instead of a comma. `noun` names the entries for the
   button's label. #}
{% macro citeList(items, limit=3, dot=false, noun="citation") %}
{%- set extra = (items | length) - limit -%}
{%- if extra < 0 %}{% set extra = 0 %}{% endif -%}
<span class="cite-list" data-cite-fit>
{%- for c in items -%}
  <span class="cite-item{% if loop.index > limit %} cite-extra{% endif %}">
    {%- if not loop.first %}{% if dot %} <span class="cite-list__dot" aria-hidden="true">·</span> {% else %}, {% endif %}{% endif -%}
    {{- c -}}
  </span>
{%- endfor -%}
</span>
{%- if (items | length) > 1 %}
<button type="button" class="cite-list__more" x-data="listToggle" x-on:click.stop.prevent="toggle"
        data-more="+{{ extra }}" data-less="less" data-noun="{{ noun }}"
        aria-label="Show {{ extra }} more {{ noun }}{% if extra != 1 %}s{% endif %}"{% if extra == 0 %} hidden{% endif %}>+{{ extra }}</button>
{%- endif %}
{% endmacro %}
