                  <li>Remanded by</li>
                  <li>Cert. granted by</li>
                </ul>
              </td>
              <td class="px-4 py-3 align-top text-greyscale-700">
                <ul class="space-y-0.5">
                  <li>Criticized by</li>
                  <li>Distinguished by</li>
                  <li>Declined to follow by</li>
                </ul>
              </td>
