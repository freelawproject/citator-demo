---
layout: layouts/base.njk
title: Search
scripts:
  - /assets/js/alpine/components/search_filter.js
---
{% from "macros/treatment.njk" import severityBadge, treatmentLine %}

{% set courts = [] %}
{% for case in index %}
  {% if case.court not in courts %}{% set _ = courts.push(case.court) %}{% endif %}
{% endfor %}

<div x-data="searchFilter()">
  <h1 class="sr-only">Demo opinions</h1>

  <div class="grid gap-6 md:gap-10 md:grid-cols-[220px_minmax(0,1fr)]">
    <aside aria-label="Filters" class="md:sticky md:top-6 md:self-start">
      <h2 class="text-xs uppercase tracking-wide text-greyscale-500 font-semibold">Filters</h2>

      <fieldset class="mt-3">
        <legend class="block text-sm font-medium text-greyscale-700">Court</legend>
        <div class="mt-2 flex flex-col gap-2">
          {% set courtNames = { "scotus": "U.S. Supreme Court", "ca1": "First Circuit", "ca2": "Second Circuit", "ca3": "Third Circuit", "ca4": "Fourth Circuit", "ca5": "Fifth Circuit", "ca6": "Sixth Circuit", "ca7": "Seventh Circuit", "ca8": "Eighth Circuit", "ca9": "Ninth Circuit", "ca10": "Tenth Circuit", "ca11": "Eleventh Circuit", "cadc": "D.C. Circuit", "cafc": "Federal Circuit" } %}
          {% for c in courts %}
          <label class="inline-flex items-center gap-2 text-sm text-greyscale-700">
            <input
              type="checkbox"
              x-on:change="toggleCourt('{{ c }}', $event.target.checked)"
              class="rounded border-greyscale-300 text-primary-600 focus-visible:ring-4 focus-visible:ring-primary-300">
            {{ courtNames[c] or c }}
          </label>
          {% endfor %}
        </div>
      </fieldset>

      <fieldset class="mt-5">
        <legend class="block text-sm font-medium text-greyscale-700">Severity</legend>
        <div class="mt-2 flex flex-col gap-2">
          {% set tiers = [{"label": "Stop", "prop": "filterStop"}, {"label": "Warning", "prop": "filterWarning"}, {"label": "Caution", "prop": "filterCaution"}, {"label": "Neutral", "prop": "filterNeutral"}] %}
          {% for t in tiers %}
          <label class="inline-flex items-center gap-2 text-sm text-greyscale-700">
            <input
              type="checkbox"
              x-on:change="{{ t.prop }} = $event.target.checked"
              class="rounded border-greyscale-300 text-primary-600 focus-visible:ring-4 focus-visible:ring-primary-300">
            {{ t.label }}
          </label>
          {% endfor %}
        </div>
      </fieldset>

      <p
        role="status"
        aria-live="polite"
        class="mt-5 pt-4 border-t border-greyscale-200 text-xs text-greyscale-500"
      >
        <span x-text="visibleCount">{{ index | length }}</span> of <span x-text="totalCount">{{ index | length }}</span> opinions
      </p>
    </aside>

    <div>
      <ul role="list" class="list-none pl-0 flex flex-col gap-4 m-0">
      {% for case in index %}
      <li
        data-court="{{ case.court }}"
        data-severity="{{ case.summary.headline.severity | lower if case.summary.headline else 'none' }}"
        x-show="(selectedCourts.length === 0 || selectedCourts.includes($el.dataset.court)) && ((!filterStop && !filterWarning && !filterCaution && !filterNeutral) || (filterStop && $el.dataset.severity === 'stop') || (filterWarning && $el.dataset.severity === 'warning') || (filterCaution && $el.dataset.severity === 'caution') || (filterNeutral && $el.dataset.severity === 'neutral'))"
        class="bg-white rounded-2xl border border-greyscale-200 p-6 md:p-7 transition-shadow hover:shadow-sm"
      >
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
          <h3 class="text-xl font-semibold leading-tight">
            <a href="/opinion/{{ case.cluster_id }}/" class="text-greyscale-900 hover:text-primary-700 hover:underline">{{ case.case_name }}</a>
          </h3>
          {% if case.summary.headline %}
            {{ treatmentLine(case.summary.headline) }}
          {% endif %}
        </div>

        <dl class="mt-2 flex flex-wrap gap-x-5 gap-y-0.5 text-xs uppercase tracking-wide text-greyscale-500">
          <div class="inline-flex gap-1.5">
            <dt class="font-semibold">Court</dt>
            <dd class="font-normal normal-case tracking-normal text-greyscale-700">{{ case.court_display }}</dd>
          </div>
          <div class="inline-flex gap-1.5">
            <dt class="font-semibold">File Date</dt>
            <dd class="font-normal normal-case tracking-normal text-greyscale-700">{{ case.date_filed }}</dd>
          </div>
        </dl>

        {% if case.excerpt %}
        <p class="mt-4 text-sm text-greyscale-600 leading-relaxed border-l-2 border-greyscale-200 pl-3">{{ case.excerpt }}</p>
        {% endif %}
      </li>
      {% endfor %}
      </ul>
    </div>
  </div>
</div>
