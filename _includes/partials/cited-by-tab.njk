{# Cited By tab: one row per later opinion that cites this one, with what
   it did itself and what it reports other courts did. Reads
   `opinion.cited_by` (sorted severity then date), `opinion.cited_by_populated`,
   `opinion.cited_by_scope` ("controlling" = every citing opinion from a
   court that binds this one; "collection" = only the opinions on the
   site) and `opinion.citing_counts`. Same column grid, sort dropdown and
   filter menu as the Authorities tab. #}
{% from "macros/list_header.njk" import listHeader, listToolbar %}
{% from "macros/treatment.njk" import severityBadge, validationDot %}
{% from "macros/evidence.njk" import evidenceCard %}
{% from "macros/lists.njk" import citeList %}
{% from "macros/icons.njk" import icon %}

<section class="cited-by" aria-label="Citing opinions" x-data="citedByFilter">
  {% if opinion.cited_by_scope == "collection" %}
  <p class="tab-note tab-note--end">
    Only the opinions in this preview are shown.
    <a href="{{ opinion.cl_url }}" target="_blank" rel="noopener" class="links">See
    {% if opinion.citing_counts and opinion.citing_counts.total %}all {{ opinion.citing_counts.total }} citing opinion{% if opinion.citing_counts.total != 1 %}s{% endif %}
    {%- else %}the citing opinions{% endif %} on CourtListener</a>
  </p>
  {% else %}
  <p class="tab-note tab-note--end">Only citing opinions from a controlling or equal court are shown.</p>
  {% endif %}

  {% if opinion.cited_by | length == 0 and opinion.cited_by_populated %}
  <p class="tab-empty">No subsequent opinions from a controlling or equal court cite this case.</p>
  {% elif opinion.cited_by | length == 0 and opinion.citing_counts %}
  {% set n = opinion.citing_counts.controlling %}
  <div class="tab-empty">
    <p class="m-0">
      {% if n == 0 %}No opinions from a controlling or equal court cite this case.
      {% else %}This opinion is cited by <strong class="font-semibold text-greyscale-900">{{ n }}</strong> opinion{% if n != 1 %}s{% endif %} from a controlling or equal court{% if opinion.citing_counts.total > n %}, {{ opinion.citing_counts.total }} in all{% endif %}. Those citing opinions are outside the preview's scope.{% endif %}
    </p>
    <p class="mt-2 m-0"><a href="{{ opinion.cl_url }}" target="_blank" rel="noopener" class="links">See the citing opinions on CourtListener</a></p>
  </div>
  {% elif opinion.cited_by | length == 0 %}
  <p class="tab-empty">Citing opinions have not been collected for this opinion yet.</p>
  {% else %}
  {{ listToolbar([
    {"key": "severity", "label": "Severity, most severe first"},
    {"key": "name", "label": "Alphabetical, A to Z"},
    {"key": "recency", "label": "Date filed, newest first"},
    {"key": "mentions", "label": "Times cited, most first"}
  ], "citing opinions", "Applied treatment", "Recognized treatment", flags.validation) }}
  {{ listHeader([
    {"label": "Treatment", "title": "What the citing opinion does to this case, then what it recognizes other courts did"},
    {"label": "Citing opinion", "title": "The citing opinion, by name"},
    {"label": "Date", "class": "col-head--pad", "title": "When the citing opinion was decided"},
    {"label": "Cites", "class": "col-head--pad", "title": "How often the citing opinion cites this case"}
  ], flags.validation) }}
  <ul role="list" class="citator-list">
    {% for cb in opinion.cited_by %}
    <li
      data-row-id="{{ cb.row_id }}"
      data-search="{{ cb.search_text }}"
      data-severity="{{ cb.severity | lower }}"
      data-applied-severity="{{ (cb.applied[0].severity if cb.applied | length else cb.severity) | lower }}"
      data-rec-severity="{{ cb.recognized_filter | lower }}"
      data-validation="{{ cb.validation }}"
      data-recency-index="{{ cb.recency_index }}"
      data-name-index="{{ cb.name_index }}"
      data-severity-index="{{ cb.severity_index }}"
      data-mentions-index="{{ cb.mentions_index }}"
      x-bind:class="rowClass"
      x-bind:style="rowStyle"
      class="cited-authority sev-rail sev-rail--{{ cb.severity | lower }}"
    >
      {% if cb.has_detail %}<details class="authority-row"><summary class="authority-row__summary">{% else %}<div>{% endif %}
        <div class="citator-row{% if flags.validation %} citator-row--validation{% endif %}">
          <div class="citator-row__treatment">
            {% for p in cb.applied %}
            <span>
              {{ severityBadge(p.severity, p.treatment) }}
              {% if flags.validation %}{{ validationDot(p.validation, p.expert_treatment) }}{% endif %}
            </span>
            {% endfor %}
            {% for p in cb.recognized %}
            <span title="{{ p.treatment_past }} as recognized by {{ cb.citing_case_name }}">
              {{ severityBadge(p.severity, p.treatment_past ~ " as recognized by") }}
              {% if flags.validation %}{{ validationDot(p.validation, p.expert_treatment) }}{% endif %}
            </span>
            {% endfor %}
          </div>
          <div class="cited-authority__body">
            <div class="citator-row__name">
              {% if cb.is_scoped %}
                <a href="/opinion/{{ cb.citing_cluster_id }}/" class="citator-row__link" x-on:click.stop>{{ cb.citing_case_name }}</a>
              {% else %}
                <span class="citator-row__title">{{ cb.citing_case_name }}</span>
              {% endif %}

            </div>
            <p class="citator-row__meta">{{ cb.citing_court_display }}</p>
            {% if cb.citing_docket_numbers | length or cb.citing_citations | length %}
            <dl class="cited-authority__meta">
              {% if cb.citing_docket_numbers | length %}
              <dt>Docket Number</dt>
              <dd>{{ citeList(cb.citing_docket_numbers, noun="docket number") }}</dd>
              {% endif %}
              {% if cb.citing_citations | length %}
              <dt>Citations</dt>
              <dd>{{ citeList(cb.citing_citations) }}</dd>
              {% endif %}
            </dl>
            {% endif %}
          </div>
          <div class="citator-row__date">{{ cb.citing_date_short }}</div>
          <div class="citator-row__cited" title="{{ cb.citing_n_mentions }} mention{% if cb.citing_n_mentions != 1 %}s{% endif %} of this case">{{ cb.citing_n_mentions or "" }}</div>
          {% if cb.has_detail %}
          {{ icon("chevron-right", "citator-row__chevron expand-chevron") }}
          {% else %}<span aria-hidden="true"></span>{% endif %}
        </div>
      {% if cb.has_detail %}</summary>
        <div class="authority-detail">
          {% for c in cb.evidence_cards %}
            {% if cb.is_scoped and (cb.citing_authority_n or c.quote_status != "missing") %}
              {# the citing opinion's own Authorities row for this case, or
                 the passage itself when its authorities were never extracted #}
              {% set href = "/opinion/" ~ cb.citing_cluster_id ~ "/" ~ ("#authority-" ~ cb.citing_authority_n if cb.citing_authority_n else "#q=" ~ (c.quote | urlencode)) %}
              {{ evidenceCard(c, "the citing opinion", href, "See it in the citing opinion") }}
            {% else %}
              {{ evidenceCard(c, "the citing opinion", "", "", false) }}
            {% endif %}
          {% endfor %}
        </div>
      </details>{% else %}</div>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
