{# Authorities tab: one row per case this opinion cites, numbered as in
   the text. Reads `opinion.cited_authorities` and
   `opinion.authorities_populated`. The sort dropdown and the filter
   menu live in macros/list_header.njk; each row carries its rank under
   every sort key, so the list reorders with CSS `order`. #}
{% from "macros/list_header.njk" import listHeader, listToolbar %}
{% from "macros/treatment.njk" import severityBadge, validationDot %}
{% from "macros/evidence.njk" import evidenceCard %}
{% from "macros/lists.njk" import citeList %}
{% from "macros/icons.njk" import icon %}

<section class="cited-authorities" aria-label="Cited authorities" x-data="authoritiesFilter">
  {% if opinion.cited_authorities | length %}
  {{ listToolbar([
    {"key": "severity", "label": "Severity, most severe first"},
    {"key": "appearance", "label": "Order of appearance, first to last"},
    {"key": "name", "label": "Alphabetical, A to Z"},
    {"key": "date", "label": "Date filed, newest first"},
    {"key": "mentions", "label": "Times cited, most first"}
  ], "authorities", "Applied treatment", "Recognized treatment", flags.validation) }}
  {{ listHeader([
    {"label": "Treatment", "title": "What this opinion does to the case, then what it recognizes other courts did"},
    {"label": "Authority", "title": "The cited case, by name"},
    {"label": "Date", "class": "col-head--pad", "title": "When the cited case was decided"},
    {"label": "Cited", "class": "col-head--pad", "title": "How often this opinion cites the case"}
  ], flags.validation) }}
  <ol role="list" class="citator-list">
    {% for a in opinion.cited_authorities %}
    <li
      id="authority-{{ a.n }}"
      data-row-id="{{ a.row_id }}"
      data-search="{{ a.search_text }}"
      data-severity="{{ a.overall_severity | lower }}"
      data-applied-severity="{{ a.severity | lower }}"
      data-rec-severity="{{ a.recognized_filter | lower }}"
      data-validation="{{ a.validation }}"
      data-appearance-index="{{ a.appearance_index }}"
      data-severity-index="{{ a.severity_index }}"
      data-date-index="{{ a.date_index }}"
      data-name-index="{{ a.name_index }}"
      data-mentions-index="{{ a.mentions_index }}"
      x-bind:class="rowClass"
      x-bind:style="rowStyle"
      class="cited-authority sev-rail sev-rail--{{ a.overall_severity | lower }}"
    >
      {% if a.has_detail %}<details class="authority-row"><summary class="authority-row__summary">{% endif %}
      <div class="citator-row{% if flags.validation %} citator-row--validation{% endif %}">
        {# what this opinion does, then what it recognizes other courts did #}
        <div class="citator-row__treatment">
          <span>
            {{ severityBadge(a.severity, a.treatment_active, false, treatment_definitions[a.treatment_active]) }}
            {% if flags.validation %}{{ validationDot(a.applied_validation, a.expert_treatment) }}{% endif %}
          </span>
          {% for r in a.recognized %}
          <span>
            {{ severityBadge(r.severity, r.label, false, treatment_definitions[r.label]) }}
            {% if flags.validation %}{{ validationDot(r.validation, a.expert_treatment) }}{% endif %}
          </span>
          {% endfor %}
        </div>
        <div class="cited-authority__body">
          <div class="citator-row__name">
            {# the name goes to the authority's own page, when the site has one #}
            {% if a.page_url %}<a href="{{ a.page_url }}" x-on:click.stop class="citator-row__link" title="Open this opinion">{{ a.name }}</a>
            {% else %}<span class="citator-row__title">{{ a.name }}</span>{% endif %}

          </div>
          <p class="citator-row__meta">
            {%- if a.court_name %}{{ a.court_name }}{% endif -%}
            {%- if a.court_name and a.status %} <span class="cite-list__dot" aria-hidden="true">·</span> {% endif -%}
            {%- if a.status %}{{ a.status }}{% endif -%}
          </p>
          {% if a.docket_numbers | length or a.citations | length or a.cited_as | length %}
          <dl class="cited-authority__meta">
            {% if a.docket_numbers | length %}
            <dt>Docket Number</dt>
            <dd>{{ citeList(a.docket_numbers, noun="docket number") }}</dd>
            {% endif %}
            {% if a.citations | length %}
            <dt>Citations</dt>
            <dd>{{ citeList(a.citations) }}</dd>
            {% endif %}
            {% if a.cited_as | length %}
            <dt>Cited as</dt>
            <dd>{{ citeList(a.cited_as, dot=true, noun="citation form") }}</dd>
            {% endif %}
          </dl>
          {% endif %}
        </div>
        <div class="citator-row__date">{{ a.date_filed }}</div>
        <div class="citator-row__cited" title="{{ a.n_mentions }} mention{% if a.n_mentions != 1 %}s{% endif %} in this opinion">{{ a.n_mentions }}</div>
        {% if a.has_detail %}
        {{ icon("chevron-right", "citator-row__chevron expand-chevron") }}
        {% else %}
        <span aria-hidden="true"></span>
        {% endif %}
      </div>
      {% if a.has_detail %}</summary>
        <div class="authority-detail">
          {% for c in a.evidence_cards %}{{ evidenceCard(c, treatment_definitions) }}{% endfor %}
        </div>
      </details>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% elif opinion.authorities_populated %}
  <p class="tab-empty">This opinion cites no other opinions.</p>
  {% else %}
  <p class="tab-empty">The authorities cited in this opinion have not been identified yet.</p>
  {% endif %}
</section>
