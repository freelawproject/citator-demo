{# Shared macros for rendering treatments and their indicators.

   - severityBadge / validationDot: primitives used by both treatment forms.
   - indicatorState: derives the validation indicator state name from
     `source` + `expert_treatment` + `treatment`. Demo-only: production
     just shows source-based dot (🔵 expert / ⚪ model). The 🟣 (purple)
     disagree overlay is computed from the paired-expert comparison.
   - treatmentBlock: verbose card-style block (opinion page summary).
   - treatmentLine: compact form with hidden hover tooltip (search results). #}

{% macro indicatorState(source, treatment, expert_treatment) %}
{%- if source == "expert" -%}
agree
{%- elif not expert_treatment -%}
unverified
{%- elif expert_treatment == treatment -%}
agree
{%- else -%}
disagree
{%- endif -%}
{% endmacro %}

{% macro severityBadge(severity, label) %}
  {% set base = "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide max-w-full min-w-0" %}
  {% set iconSize = "w-3.5 h-3.5 flex-shrink-0" %}
  {% if label == "Affirmed by" or label == "Affirms" %}
    {# Display-only positive indicator. Underlying severity remains
       "Neutral" per the canonical treatment taxonomy. #}
    {% set classes = base ~ " bg-green-500/10 text-green-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>{% endset %}
  {% elif severity == "Stop" %}
    {% set classes = base ~ " bg-red-500/10 text-red-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" /></svg>{% endset %}
  {% elif severity == "Warning" %}
    {% set classes = base ~ " bg-orange-500/10 text-orange-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>{% endset %}
  {% elif severity == "Caution" %}
    {% set classes = base ~ " bg-amber-500/15 text-amber-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a.75.75 0 00-.75.75v3.5a.75.75 0 001.5 0v-3.5A.75.75 0 0010 5z" clip-rule="evenodd" /></svg>{% endset %}
  {% else %}
    {% set classes = base ~ " bg-greyscale-200 text-greyscale-700" %}
    {% set icon %}<svg class="{{ iconSize }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9.5a.75.75 0 000 1.5h6a.75.75 0 000-1.5H7z" clip-rule="evenodd" /></svg>{% endset %}
  {% endif %}
  <span class="{{ classes }}" title="{{ label }}">{{ icon | safe }}<span class="truncate severity-badge-label">{{ label }}</span></span>
{% endmacro %}

{# Validation indicator tooltip.
   - `state`: "agree" | "unverified" | "disagree" — derived via indicatorState.
   - `expert_treatment`: optional. Surfaces the expert's classification on
     a second tooltip line when `state == "disagree"`. Ignored otherwise.
   - Visible tooltip is a short status label; aria-label is a fuller natural-
     language sentence so screen readers narrate the meaning clearly. #}
{% macro validationDot(state, expert_treatment="") %}
  {% set svgBase = "w-4 h-4 flex-shrink-0" %}
  {% if state == "agree" %}
    {% set tooltip = "Validated" %}
    {% set ariaLabel = "Validated treatment classification" %}
    {% set svg %}<svg class="{{ svgBase }} text-blue-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
  {% elif state == "disagree" %}
    {% if expert_treatment %}
      {% set tooltip %}Invalidated
Expert: {{ expert_treatment }}{% endset %}
      {% set ariaLabel = "Invalidated by expert. Expert classification: " ~ expert_treatment %}
    {% else %}
      {% set tooltip = "Invalidated" %}
      {% set ariaLabel = "Invalidated treatment classification" %}
    {% endif %}
    {% set svg %}<svg class="{{ svgBase }} text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
  {% else %}
    {% set tooltip = "Unvalidated" %}
    {% set ariaLabel = "Unvalidated treatment classification" %}
    {% set svg %}<svg class="{{ svgBase }} text-greyscale-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>{% endset %}
  {% endif %}
  <span class="tooltip-target tooltip-target--right p-1 -m-1 align-middle" data-tooltip="{{ tooltip }}" role="img" aria-label="{{ ariaLabel }}">
    {{ svg | safe }}
  </span>
{% endmacro %}

{# Verbose form: severity badge + validation icon + labeled citing-case
   metadata + collapsible "Show supporting quote". Used on opinion pages.
   `label` is a small uppercase eyebrow at the top of the card; pass ""
   when the card sits inside an external picker that already labels it. #}
{% macro treatmentBlock(pointer, label="") %}
  {% set vstate = indicatorState(pointer.source, pointer.treatment, pointer.expert_treatment) | trim %}
  <article class="rounded-2xl border border-greyscale-200 bg-white px-5 py-4">
    {% if label %}
    <p class="text-xs uppercase tracking-wide font-semibold text-greyscale-500 mb-2">{{ label }}</p>
    {% endif %}
    <div class="flex flex-wrap items-center gap-x-2 gap-y-2">
      {{ severityBadge(pointer.severity, pointer.treatment) }}
      <span class="font-semibold text-greyscale-900">
        {% if pointer.is_scoped %}
          <a href="/opinion/{{ pointer.citing_cluster_id }}/" class="hover:text-primary-700 hover:underline">{{ pointer.citing_case_name }}</a>
        {% else %}
          {{ pointer.citing_case_name }}
        {% endif %}
      </span>
      {{ validationDot(vstate, pointer.expert_treatment) }}
    </div>
    <dl class="mt-3 grid gap-y-1 text-xs">
      {# Line 1: Court + File Date #}
      <div class="flex flex-wrap gap-x-10 gap-y-0.5">
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
          <dt class="uppercase tracking-wide font-semibold text-greyscale-500">Court</dt>
          <dd class="text-greyscale-700">{{ pointer.citing_court_display }}</dd>
        </div>
        <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
          <dt class="uppercase tracking-wide font-semibold text-greyscale-500">File Date</dt>
          <dd class="text-greyscale-700">{{ pointer.citing_date_filed }}</dd>
        </div>
      </div>
      {# Line 2: Docket Number #}
      {% if pointer.citing_docket_number %}
      <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
        <dt class="uppercase tracking-wide font-semibold text-greyscale-500">Docket Number</dt>
        <dd class="text-greyscale-700">{{ pointer.citing_docket_number }}</dd>
      </div>
      {% endif %}
      {# Line 3: Citations — first 3 always shown; remaining hidden behind a
         "+N" expand button. Each card scopes its own showAll state. #}
      {% if pointer.citing_citations %}
      {% set citationCount = pointer.citing_citations | length %}
      <div class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5" x-data="{ showAll: false }">
        <dt class="uppercase tracking-wide font-semibold text-greyscale-500">Citations</dt>
        <dd class="text-greyscale-700">
          {% for c in pointer.citing_citations %}
            {%- if loop.index == 1 -%}
              {{ c }}
            {%- elif loop.index <= 3 -%}
              <span class="text-greyscale-400" aria-hidden="true"> · </span>{{ c }}
            {%- else -%}
              <span x-show="showAll" x-cloak><span class="text-greyscale-400" aria-hidden="true"> · </span>{{ c }}</span>
            {%- endif -%}
          {% endfor %}
          {% if citationCount > 3 %}
          <button
            type="button"
            x-show="!showAll"
            x-on:click="showAll = true"
            aria-label="Show {{ citationCount - 3 }} more citation{% if citationCount - 3 != 1 %}s{% endif %}"
            class="ml-1 inline-flex items-center justify-center rounded-full bg-greyscale-100 hover:bg-greyscale-200 px-1.5 py-0.5 text-[10px] font-semibold text-greyscale-600 transition"
          >
            +{{ citationCount - 3 }}
          </button>
          {% endif %}
        </dd>
      </div>
      {% endif %}
    </dl>

    {% if pointer.expand and pointer.expand.context %}
    {% set ctx = pointer.expand.context %}
    <details class="treatment-expand mt-4">
      <summary class="cursor-pointer inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 select-none">
        <svg class="w-3.5 h-3.5 expand-chevron transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span>Show supporting quote</span>
      </summary>
      <p class="mt-3 pl-3 border-l-2 border-greyscale-200 text-sm text-greyscale-700 leading-relaxed">
        {%- if ctx.before %}{{ ctx.before }} {% endif -%}
        <span class="inline bg-yellow-100 text-greyscale-900 font-semibold rounded px-1">{{ ctx.quote }}</span>
        {%- if ctx.after %} {{ ctx.after }}{% endif -%}
      </p>
    </details>
    {% endif %}
  </article>
{% endmacro %}

{# Compact form: severity badge + validation icon, with a click-dropdown
   for citing-case context (case name, court, file date) and a hover
   tooltip surfacing the full treatment text when truncated. Used on the
   search results cards. #}
{% macro treatmentLine(pointer) %}
  {% set vstate = indicatorState(pointer.source, pointer.treatment, pointer.expert_treatment) | trim %}
  {# Hover tooltip surfaces the full treatment text — useful when the
     badge label is truncated to fit a narrow column. #}
  {% set tipBody %}
    <span class="rich-tooltip absolute top-full mt-2 right-0 z-20 w-max max-w-[280px] bg-greyscale-900 text-white rounded-lg shadow-lg px-4 py-3 text-left pointer-events-none opacity-0 invisible transition-opacity text-xs leading-snug">
      {{ pointer.treatment }}
    </span>
  {% endset %}
  <div class="relative flex flex-nowrap items-center gap-x-1.5 text-sm min-w-0"
       x-data="{ expanded: false, isTruncated: false }"
       x-init="$nextTick(() => { const el = $el.querySelector('.severity-badge-label'); if (el) isTruncated = el.scrollWidth > el.clientWidth + 1; })">
    {# Hover tooltip only renders when the badge label is truncated, so
       short treatments don't get a redundant tooltip. min-w-0 lets the
       badge shrink and truncate when the parent constrains width. #}
    <span class="relative tooltip-host min-w-0">
      {{ severityBadge(pointer.severity, pointer.treatment) }}
      <template x-if="isTruncated">
        {{ tipBody | safe }}
      </template>
    </span>
    <span class="ml-auto flex items-center gap-x-2 flex-shrink-0">
      <button
        type="button"
        x-on:click.stop="expanded = !expanded"
        x-bind:aria-expanded="expanded"
        aria-label="Show citing case info"
        class="inline-flex items-center justify-center w-5 h-5 rounded-full text-greyscale-500 hover:bg-greyscale-100 hover:text-greyscale-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300"
      >
        <svg class="w-3.5 h-3.5 transition-transform" x-bind:class="expanded ? 'rotate-180' : ''" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
      {{ validationDot(vstate, pointer.expert_treatment) }}
    </span>
    <div
      x-show="expanded"
      x-cloak
      x-on:click.outside="expanded = false"
      x-on:keydown.escape.window="expanded = false"
      role="dialog"
      class="absolute z-30 top-full right-0 mt-1 w-max max-w-[300px] rounded-lg border border-greyscale-200 bg-white shadow-lg px-3 py-2 text-xs leading-snug text-greyscale-900"
    >
      {% if pointer.severity == "Neutral" and pointer.treatment == "Cited by" %}
        {# Neutral fallback — the pointer is one of potentially many
           neutral citing references. Surfacing a single case's metadata
           would misrepresent that. Explain absence-of-negatives instead. #}
        <span class="block text-greyscale-700 leading-relaxed">No negative treatments have been identified for this opinion. See the Cited By tab on the opinion page for the full list of citing cases.</span>
      {% else %}
        {% if pointer.is_scoped %}
          <a href="/opinion/{{ pointer.citing_cluster_id }}/" class="block font-semibold text-sm leading-snug text-greyscale-900 hover:text-primary-700 hover:underline">{{ pointer.citing_case_name }}</a>
        {% else %}
          <span class="block font-semibold text-sm leading-snug text-greyscale-900">{{ pointer.citing_case_name }}</span>
        {% endif %}
        <span class="mt-2 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 leading-normal">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-greyscale-500">Court</span>
          <span>{{ pointer.citing_court_display }}</span>
          <span class="text-[10px] font-semibold uppercase tracking-wide text-greyscale-500">File Date</span>
          <span>{{ pointer.citing_date_filed }}</span>
        </span>
      {% endif %}
    </div>
  </div>
{% endmacro %}

{# Muted-grey badge for empty-state slots (no Direct history pointer, no
   Citing reference at all). Shows lean placeholder text on the badge
   with the full explainer in a click-dropdown. The check / question
   icon sits to the right of the badge — outside the badge box —
   mirroring how validationDot is positioned next to a real treatment.

   `variant`:
     - "verified"   → blue check icon. Use when absence is definitive
       and expected (e.g., a court of last resort can't have direct
       history).
     - "unverified" → grey question icon. Use when absence is just
       absence of recorded data ("none identified in our dataset"). #}
{% macro emptyTreatmentBadge(label, variant, tooltip) %}
  {% set iconSize = "w-4 h-4 flex-shrink-0" %}
  {% if variant == "verified" %}
    {% set icon %}<svg class="{{ iconSize }} text-blue-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
    {% set iconAria = "Validated" %}
    {% set iconTooltip = "Validated" %}
  {% else %}
    {% set icon %}<svg class="{{ iconSize }} text-greyscale-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>{% endset %}
    {% set iconAria = "Unvalidated" %}
    {% set iconTooltip = "Unvalidated" %}
  {% endif %}
  {# Inner badge icon: matches the Neutral severityBadge aesthetic
     (filled grey circle with a horizontal line) so the empty-state
     badge reads as "no severity / no signal" alongside the colored
     real-treatment badges. #}
  {% set badgeIcon %}<svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9.5a.75.75 0 000 1.5h6a.75.75 0 000-1.5H7z" clip-rule="evenodd" /></svg>{% endset %}
  <div class="relative flex flex-nowrap items-center gap-x-1.5 text-sm"
       x-data="{ expanded: false }">
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide whitespace-nowrap bg-greyscale-200 text-greyscale-700">
      {{ badgeIcon | safe }}{{ label }}
    </span>
    <span class="ml-auto flex items-center gap-x-2 flex-shrink-0">
      <button
        type="button"
        x-on:click.stop="expanded = !expanded"
        x-bind:aria-expanded="expanded"
        aria-label="Show explanation"
        class="inline-flex items-center justify-center w-5 h-5 rounded-full text-greyscale-500 hover:bg-greyscale-100 hover:text-greyscale-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300"
      >
        <svg class="w-3.5 h-3.5 transition-transform" x-bind:class="expanded ? 'rotate-180' : ''" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
      <span class="tooltip-target tooltip-target--right p-1 -m-1 align-middle" data-tooltip="{{ iconTooltip }}" role="img" aria-label="{{ iconAria }}">
        {{ icon | safe }}
      </span>
    </span>
    <div
      x-show="expanded"
      x-cloak
      x-on:click.outside="expanded = false"
      x-on:keydown.escape.window="expanded = false"
      role="dialog"
      class="absolute z-30 top-full right-0 mt-1 w-max max-w-[300px] rounded-lg border border-greyscale-200 bg-white shadow-lg px-3 py-2 text-xs leading-snug text-greyscale-700"
    >
      {{ tooltip }}
    </div>
  </div>
{% endmacro %}

{# Inline empty-state header (no dropdown). Used inside opinion-page
   empty cards where the explanation paragraph follows directly below.
   `variant`: "verified" (blue check) | "unverified" (grey question). #}
{% macro emptyTreatmentInline(label, variant) %}
  {% set badgeIcon %}<svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9.5a.75.75 0 000 1.5h6a.75.75 0 000-1.5H7z" clip-rule="evenodd" /></svg>{% endset %}
  {% if variant == "verified" %}
    {% set checkIcon %}<svg class="w-4 h-4 flex-shrink-0 text-blue-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{% endset %}
    {% set iconAria = "Validated" %}
    {% set iconTooltip = "Validated" %}
  {% else %}
    {% set checkIcon %}<svg class="w-4 h-4 flex-shrink-0 text-greyscale-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>{% endset %}
    {% set iconAria = "Unvalidated" %}
    {% set iconTooltip = "Unvalidated" %}
  {% endif %}
  <div class="flex flex-wrap items-center gap-x-2 gap-y-2">
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide whitespace-nowrap bg-greyscale-200 text-greyscale-700">
      {{ badgeIcon | safe }}{{ label }}
    </span>
    <span class="tooltip-target tooltip-target--right p-1 -m-1 align-middle" data-tooltip="{{ iconTooltip }}" role="img" aria-label="{{ iconAria }}">
      {{ checkIcon | safe }}
    </span>
  </div>
{% endmacro %}
