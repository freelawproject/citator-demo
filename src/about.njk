          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
        <span>See the full treatment list</span>
      </summary>
      <div class="mt-4 overflow-x-auto rounded-lg border border-greyscale-200">
        <table class="w-full text-sm border-collapse table-fixed">
          <thead>
            <tr class="bg-greyscale-50 text-left">
              <th class="w-1/5 px-4 py-2.5 font-semibold uppercase tracking-wide text-xs text-greyscale-500 border-b border-greyscale-200">Severity</th>
              <th class="w-2/5 px-4 py-2.5 font-semibold uppercase tracking-wide text-xs text-greyscale-500 border-b border-greyscale-200">Direct history</th>
              <th class="w-2/5 px-4 py-2.5 font-semibold uppercase tracking-wide text-xs text-greyscale-500 border-b border-greyscale-200">Citing reference</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-greyscale-100">
            <tr>
              <td class="px-4 py-3 align-top">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide bg-red-500/10 text-red-700">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" /></svg>
