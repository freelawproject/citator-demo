{# Authorities tab content. Expects:
   - `opinion.authorities` array (pre-sorted severity asc, date desc).
   Lives inside an Alpine `x-data="authoritiesFilter"` scope. #}
{% from "macros/treatment.njk" import severityBadge, validationDot %}

<div x-data="authoritiesFilter">
  <div class="flex flex-wrap items-end gap-x-6 gap-y-4">
    <fieldset>
      <legend class="text-xs uppercase tracking-wide font-semibold text-greyscale-500 mb-2">Severity</legend>
      <div class="flex flex-wrap gap-2">
        {% set sevTiers = [
          {"label": "Stop", "prop": "filterStop"},
          {"label": "Warning", "prop": "filterWarning"},
          {"label": "Caution", "prop": "filterCaution"},
          {"label": "Neutral", "prop": "filterNeutral"},
          {"label": "Related", "prop": "filterRelated"}
        ] %}
        {% for s in sevTiers %}
        <button
          type="button"
          x-on:click="toggleFilter('{{ s.prop }}')"
          x-bind:aria-pressed="{{ s.prop }} ? 'true' : 'false'"
          x-bind:class="{{ s.prop }} ? 'bg-greyscale-900 text-white border-greyscale-900' : 'bg-white text-greyscale-700 border-greyscale-300 hover:bg-greyscale-100'"
          class="px-3 py-1 text-xs font-medium rounded-full border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300"
        >
          {{ s.label }}
        </button>
        {% endfor %}
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-xs uppercase tracking-wide font-semibold text-greyscale-500 mb-2">Validation</legend>
      <div class="flex flex-wrap gap-2">
        {% set valTiers = [
          {"label": "Agree", "prop": "filterAgree"},
          {"label": "Unverified", "prop": "filterUnverified"},
          {"label": "Disagree", "prop": "filterDisagree"}
        ] %}
        {% for v in valTiers %}
        <button
          type="button"
          x-on:click="toggleFilter('{{ v.prop }}')"
          x-bind:aria-pressed="{{ v.prop }} ? 'true' : 'false'"
          x-bind:class="{{ v.prop }} ? 'bg-greyscale-900 text-white border-greyscale-900' : 'bg-white text-greyscale-700 border-greyscale-300 hover:bg-greyscale-100'"
          class="px-3 py-1 text-xs font-medium rounded-full border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300"
        >
          {{ v.label }}
        </button>
        {% endfor %}
      </div>
    </fieldset>

    <div>
      <label for="authorities-sort" class="block text-xs uppercase tracking-wide font-semibold text-greyscale-500 mb-2">Sort</label>
      <select
        id="authorities-sort"
        x-on:change="setSort($event.target.value)"
        class="px-3 py-1.5 text-sm border border-greyscale-300 rounded-lg bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300"
      >
        <option value="severity">Severity, then recency</option>
        <option value="appearance">Order of appearance</option>
      </select>
    </div>

    <p
      role="status"
      aria-live="polite"
      class="ml-auto text-xs text-greyscale-500"
    >
      <span x-text="visibleCount">{{ opinion.authorities | length }}</span> of <span x-text="totalCount">{{ opinion.authorities | length }}</span> authorities
    </p>
  </div>

  <ul role="list" class="mt-6 list-none pl-0 m-0 flex flex-col bg-white rounded-2xl border border-greyscale-200 overflow-hidden">
    {% for auth in opinion.authorities %}
    <li
      data-row-id="{{ auth.row_id }}"
      data-severity="{{ auth.severity | lower }}"
      data-validation="{{ auth.validation.state }}"
      data-appearance-index="{{ loop.index0 }}"
      x-show="rowVisible($el)"
      x-bind:style="rowOrder($el)"
      class="border-b border-greyscale-200 last:border-b-0"
    >
      <details class="authority-row">
        <summary class="cursor-pointer list-none px-5 py-3.5 hover:bg-greyscale-50 focus-visible:bg-greyscale-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-300">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            {{ validationDot(auth.validation.state) }}
            {{ severityBadge(auth.severity, auth.treatment_active) }}
            <span class="flex-1 min-w-0 text-sm">
              {% if auth.is_scoped %}
                <a href="/opinion/{{ auth.cited_cluster_id }}/" class="font-semibold text-greyscale-900 hover:text-primary-700 hover:underline" x-on:click.stop>{{ auth.cited_case_name }}</a>
              {% else %}
                <span class="font-semibold text-greyscale-900">{{ auth.cited_case_name }}</span>
              {% endif %}
              <span class="text-greyscale-500">, {{ auth.cited_citation }}</span>
            </span>
            <svg class="w-4 h-4 expand-chevron text-greyscale-400 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </div>
        </summary>

        <div class="px-5 py-4 bg-greyscale-50 border-t border-greyscale-200 space-y-3 text-sm">
          {% if auth.expand and auth.expand.context %}
          {% set ctx = auth.expand.context %}
          <p class="pl-3 border-l-2 border-greyscale-300 text-greyscale-700 leading-relaxed">
            {%- if ctx.before %}{{ ctx.before }} {% endif -%}
            <button
              type="button"
              x-on:click="$dispatch('quote-click', { quote: {{ ctx.quote | dump | safe }} })"
              class="inline text-left bg-yellow-100 text-greyscale-900 font-semibold rounded px-1 cursor-pointer hover:bg-yellow-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 transition-colors"
              aria-label="Show this quote in the opinion body"
            >{{ ctx.quote }}</button>
            {%- if ctx.after %} {{ ctx.after }}{% endif -%}
          </p>
          {% endif %}
        </div>
      </details>
    </li>
    {% endfor %}
  </ul>
</div>
